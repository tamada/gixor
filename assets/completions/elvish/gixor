
use builtin;
use str;

set edit:completion:arg-completer[gixor] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'gixor'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'gixor'= {
            cand -l 'Specify the log level'
            cand --log 'Specify the log level'
            cand -c 'Specify the configuration file'
            cand --config 'Specify the configuration file'
            cand --no-network 'Disable network access'
            cand -h 'Print help'
            cand --help 'Print help'
            cand -V 'Print version'
            cand --version 'Print version'
            cand alias 'Manage the aliases. If no command is given, list the aliases.'
            cand dump 'Dump the boilerplates'
            cand entries 'List the current entries in the .gitignore file'
            cand init 'Initialize the Gixor'
            cand list 'List available boilerplates'
            cand root 'Show the root directory of the boilerplates'
            cand search 'Search the boilerplates from the query'
            cand update 'Update the gitignore boilerplate repositories (alias of `repository update`)'
            cand repository 'Manage the gitignore boilerplate repositories'
            cand generate-completion-files 'Generate the completion files'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'gixor;alias'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand add 'Add a new alias'
            cand remove 'Remove an existing alias'
            cand list 'List all aliases'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'gixor;alias;add'= {
            cand -d 'Specify the alias description for registration.'
            cand --description 'Specify the alias description for registration.'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'gixor;alias;remove'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'gixor;alias;list'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'gixor;alias;help'= {
            cand add 'Add a new alias'
            cand remove 'Remove an existing alias'
            cand list 'List all aliases'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'gixor;alias;help;add'= {
        }
        &'gixor;alias;help;remove'= {
        }
        &'gixor;alias;help;list'= {
        }
        &'gixor;alias;help;help'= {
        }
        &'gixor;dump'= {
            cand -d 'Specify the destination directory. "-" means stdout.'
            cand --dest 'Specify the destination directory. "-" means stdout.'
            cand --no-append 'Drop the entries currently listed in the gitignore.'
            cand --clear-prologue 'Drop the prologue, the part of the gitignore before the first boilerplate.'
            cand -c 'Start from scratch, dropping both the prologue and the current entries.'
            cand --clear 'Start from scratch, dropping both the prologue and the current entries.'
            cand -n 'Print the result to stdout and leave the gitignore untouched.'
            cand --dry-run 'Print the result to stdout and leave the gitignore untouched.'
            cand -a 'Kept so that existing scripts keep working. Appending is the default now'
            cand --append 'Kept so that existing scripts keep working. Appending is the default now'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'gixor;entries'= {
            cand -d 'Specify the directory located the .gitignore file'
            cand --dir 'Specify the directory located the .gitignore file'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'gixor;init'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'gixor;list'= {
            cand --no-header 'Hide repository headers'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'gixor;root'= {
            cand -o 'Open the folder in the GUI file manager'
            cand --open 'Open the folder in the GUI file manager'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'gixor;search'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'gixor;update'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'gixor;repository'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand add 'Add a new gitignore boilerplate repository'
            cand list 'List the current gitignore boilerplate repositories'
            cand remove 'Remove a gitignore boilerplate repository'
            cand update 'Run `git update` for updating a gitignore boilerplate repository'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'gixor;repository;add'= {
            cand -n 'Specify the name of the gitignore boilerplate repository'
            cand --name 'Specify the name of the gitignore boilerplate repository'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'gixor;repository;list'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'gixor;repository;remove'= {
            cand -k 'Do not remove the directory of corresponding repository'
            cand --keep-dir 'Do not remove the directory of corresponding repository'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'gixor;repository;update'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'gixor;repository;help'= {
            cand add 'Add a new gitignore boilerplate repository'
            cand list 'List the current gitignore boilerplate repositories'
            cand remove 'Remove a gitignore boilerplate repository'
            cand update 'Run `git update` for updating a gitignore boilerplate repository'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'gixor;repository;help;add'= {
        }
        &'gixor;repository;help;list'= {
        }
        &'gixor;repository;help;remove'= {
        }
        &'gixor;repository;help;update'= {
        }
        &'gixor;repository;help;help'= {
        }
        &'gixor;generate-completion-files'= {
            cand --completion-out-dir 'Output directory of completion files'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'gixor;help'= {
            cand alias 'Manage the aliases. If no command is given, list the aliases.'
            cand dump 'Dump the boilerplates'
            cand entries 'List the current entries in the .gitignore file'
            cand init 'Initialize the Gixor'
            cand list 'List available boilerplates'
            cand root 'Show the root directory of the boilerplates'
            cand search 'Search the boilerplates from the query'
            cand update 'Update the gitignore boilerplate repositories (alias of `repository update`)'
            cand repository 'Manage the gitignore boilerplate repositories'
            cand generate-completion-files 'Generate the completion files'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'gixor;help;alias'= {
            cand add 'Add a new alias'
            cand remove 'Remove an existing alias'
            cand list 'List all aliases'
        }
        &'gixor;help;alias;add'= {
        }
        &'gixor;help;alias;remove'= {
        }
        &'gixor;help;alias;list'= {
        }
        &'gixor;help;dump'= {
        }
        &'gixor;help;entries'= {
        }
        &'gixor;help;init'= {
        }
        &'gixor;help;list'= {
        }
        &'gixor;help;root'= {
        }
        &'gixor;help;search'= {
        }
        &'gixor;help;update'= {
        }
        &'gixor;help;repository'= {
            cand add 'Add a new gitignore boilerplate repository'
            cand list 'List the current gitignore boilerplate repositories'
            cand remove 'Remove a gitignore boilerplate repository'
            cand update 'Run `git update` for updating a gitignore boilerplate repository'
        }
        &'gixor;help;repository;add'= {
        }
        &'gixor;help;repository;list'= {
        }
        &'gixor;help;repository;remove'= {
        }
        &'gixor;help;repository;update'= {
        }
        &'gixor;help;generate-completion-files'= {
        }
        &'gixor;help;help'= {
        }
    ]
    $completions[$command]
}
